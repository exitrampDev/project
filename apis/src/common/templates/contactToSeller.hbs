```
    <!-- Email Container -->
    <table width="600" cellpadding="0" cellspacing="0" style="background-color:#ffffff; border-radius:8px; overflow:hidden;">

      <!-- Header / Hero -->
      <tr>
        <td style="background-color:#062f5f; padding:32px;">
          <table width="100%">
            <tr>
              <td align="left" style="color:#ffffff; font-size:22px; font-weight:bold;">
                EXIT<span style="color:#ffb703;">RAMP</span>
              </td>
              <td align="right" style="color:#ffffff; font-size:14px;">
                Confidential M&amp;A Marketplace
              </td>
            </tr>
          </table>

          <div style="margin-top:30px; color:#ffffff;">
            <h1 style="margin:0; font-size:28px; line-height:1.3;">
              New Message from a Buyer
            </h1>
            <p style="margin-top:12px; font-size:16px; color:#dbe6f3;">
              A buyer has contacted you regarding your business listing.
            </p>
          </div>
        </td>
      </tr>

      <!-- Content -->
      <tr>
        <td style="padding:32px; color:#1f2937;">
          <p style="font-size:16px; margin-top:0;">
            Hello,
          </p>

          <p style="font-size:16px;">
            You have received a new message from a buyer interested in your business:
          </p>

          <!-- Business Card -->
          <table width="100%" cellpadding="0" cellspacing="0"
                 style="background-color:#f8fafc; border:1px solid #e5e7eb; border-radius:6px; margin:20px 0;">
            <tr>
              <td style="padding:20px;">
                <p style="margin:0; font-size:14px; color:#6b7280;">
                  Business Name
                </p>
                <p style="margin:6px 0 0; font-size:18px; font-weight:bold; color:#062f5f;">
                  {{businessName}}
                </p>
              </td>
            </tr>
          </table>

          <!-- Buyer Message -->
          <table width="100%" cellpadding="0" cellspacing="0"
                 style="background-color:#ffffff; border:1px solid #e5e7eb; border-radius:6px; margin:20px 0;">
            <tr>
              <td style="padding:20px;">
                <p style="margin:0 0 8px; font-size:14px; color:#6b7280;">
                  Buyer Message
                </p>
                <p style="margin:0; font-size:16px; color:#1f2937; line-height:1.6;">
                  {{buyerMessage}}
                </p>
                <small style="display:block; margin-top:12px; font-size:12px; color:#9ca3af;">
                 Buyer Email: {{senderEmail}}
                </small>
              </td>
            </tr>
          </table>

          {{!-- <p style="font-size:16px;">
            Please log in to your dashboard to reply securely and continue the conversation.
          </p>

          <!-- CTA Button -->
          <table cellpadding="0" cellspacing="0" style="margin:30px 0;">
            <tr>
              <td align="center">
                <a href="{{dashboardUrl}}"
                   style="
                     background-color:#ffb703;
                     color:#062f5f;
                     text-decoration:none;
                     padding:14px 26px;
                     border-radius:6px;
                     font-weight:bold;
                     font-size:16px;
                     display:inline-block;
                   ">
                  View Message in Dashboard
                </a>
              </td>
            </tr>
          </table> --}}

          <p style="font-size:14px; color:#6b7280;">
            For your privacy and security, please avoid replying directly to this email.
          </p>
        </td>
      </tr>

      <!-- Footer -->
      <tr>
        <td style="background-color:#f1f5f9; padding:20px; text-align:center;">
          <p style="margin:0; font-size:12px; color:#6b7280;">
            © {{year}} Exit Ramp. All rights reserved.
          </p>
          <p style="margin:6px 0 0; font-size:12px; color:#6b7280;">
            Confidential • Secure • Trusted
          </p>
        </td>
      </tr>

    </table>

  </td>
</tr>
